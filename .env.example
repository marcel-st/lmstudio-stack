# LM Studio model identifier (as listed on lmstudio.ai/models)
MODEL=google/gemma-4-12b

# Context length loaded into the model at startup.
# To change: update the value here, then run:
#   ./scripts/reload-context.sh <new_length>
#
# VRAM budget on RTX 5060 Ti 16 GB (approximate Q4_K_M):
#   Gemma 4 12B model:      ~7.4 GB
#   CUDA runtime:           ~0.3 GB
#   KV cache @ 16384 ctx:   ~1.5 GB
#   2× 4K Plex transcode:   ~4.0 GB
#   Total:                  ~13.2 GB  (2.8 GB headroom)
#
#   Safe range: 4096–16384. Above 16384 may OOM during concurrent Plex use.
#   With Plex idle: up to 24576 ctx is viable (~2.0 GB KV, ~14.0 GB total).
CONTEXT_LENGTH=16384

# GPU mode for lms load:
#   max   (default) — all layers on GPU; optimal for single model on 16 GB
#   auto            — LM Studio auto-fits; use if GPU is shared with heavy workloads
#   off             — CPU only
GPU_MODE=max

# LiteLLM secrets — generate with: openssl rand -hex 32
# LITELLM_MASTER_KEY must start with "sk-"
# LITELLM_SALT_KEY must NEVER change after first run (breaks all existing virtual keys)
LITELLM_MASTER_KEY=sk-changeme-replace-with-openssl-rand-hex-32
LITELLM_SALT_KEY=changeme-replace-with-openssl-rand-hex-32

# PostgreSQL password
POSTGRES_PASSWORD=changeme-replace-with-a-strong-password
