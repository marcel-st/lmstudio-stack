# LM Studio model identifiers (as listed on lmstudio.ai/models)
GEMMA_MODEL=google/gemma-4-e4b
QWEN_MODEL=qwen/qwen2.5-coder-7b

# Context length loaded into each model at startup.
# To change: update the value here, then run:
#   docker compose restart lmstudio
# Then update max_input_tokens + context_window in the LiteLLM admin UI.
# RTX 3060 12GB VRAM budget: both models at 8192 use ~9.6 GB (safe).
# Both at 16384 exceeds 12 GB — keep one at 8192 if raising the other.
GEMMA_CONTEXT_LENGTH=8192
QWEN_CONTEXT_LENGTH=8192

# LiteLLM secrets — generate with: openssl rand -hex 32
# LITELLM_MASTER_KEY must start with "sk-"
# LITELLM_SALT_KEY must NEVER change after first run (breaks all existing virtual keys)
LITELLM_MASTER_KEY=sk-changeme-replace-with-openssl-rand-hex-32
LITELLM_SALT_KEY=changeme-replace-with-openssl-rand-hex-32

# PostgreSQL password
POSTGRES_PASSWORD=changeme-replace-with-a-strong-password
